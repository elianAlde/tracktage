Options -Indexes
RewriteEngine On

# File sensibili mai serviti
<FilesMatch "^(\.env.*|.*\.sqlite.*|.*\.sql|README\.md|\.gitignore)$">
    Require all denied
</FilesMatch>
RewriteRule ^(database|bin|config|lang|middleware|components|views)/ - [F,L]

# Se esiste un file o directory, non riscrivere
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Tutte le pagine passano dal router (che controlla il login)
RewriteRule ^([a-zA-Z0-9_-]+)$ index.php?page=$1 [QSA,L]

DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>
