Options -Indexes
RewriteEngine On

# Never serve secrets, data or internal folders
<FilesMatch "^(\.env.*|.*\.sqlite.*|.*\.sql|README\.md|\.gitignore|\.editorconfig)$">
    Require all denied
</FilesMatch>
RewriteRule ^(database|bin|config|lang|middleware|components|views)/ - [F,L]

# Serve existing files as they are; everything else goes through the router, which checks the login
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)$ index.php?page=$1 [QSA,L]

DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>
