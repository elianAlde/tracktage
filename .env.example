BASE_URL=http://localhost:8000/
SESSION_NAME=tracktage_session

# SQLite file, relative to the project root or absolute (ideally outside the web root)
DB_PATH=database/tracktage.sqlite

# Default language (it | en); each device can change it in Settings
DEFAULT_LANG=it

# Currency the whole net worth is expressed in
BASE_CURRENCY=EUR

# How long price quotes are cached, in minutes
PRICE_CACHE_MINUTES=15

# Months after which a manual value (car, account...) is flagged as outdated
STALE_MONTHS=6

# true in production (HTTPS): the session cookie is only sent over secure connections
SESSION_SECURE=true
APP_DEBUG=false
