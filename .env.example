BASE_URL=http://localhost:8000/
SESSION_NAME=tracktage_session

# Percorso del file SQLite (relativo alla root del progetto o assoluto)
DB_PATH=database/tracktage.sqlite

# Valuta di riferimento per il patrimonio
BASE_CURRENCY=EUR

# Minuti di validità della cache dei prezzi
PRICE_CACHE_MINUTES=15

# Dopo quanti mesi un valore inserito a mano (auto, conti...) va segnalato come da aggiornare
STALE_MONTHS=6

# true in produzione (HTTPS): cookie di sessione solo su connessioni sicure
SESSION_SECURE=true
APP_DEBUG=false
